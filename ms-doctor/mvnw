#!/bin/sh
# Maven Wrapper script
set -e

# Locate script directory
SCRIPT_DIR=$(cd "$(dirname "$0")" && pwd)
MAVEN_WRAPPER_JAR="$SCRIPT_DIR/.mvn/wrapper/maven-wrapper.jar"
MAVEN_WRAPPER_PROPERTIES="$SCRIPT_DIR/.mvn/wrapper/maven-wrapper.properties"

# Read distributionUrl
DISTRIBUTION_URL=$(grep "distributionUrl" "$MAVEN_WRAPPER_PROPERTIES" | cut -d= -f2)

# Check if mvn is already installed
if command -v mvn > /dev/null 2>&1; then
    exec mvn "$@"
fi

MAVEN_HOME="$HOME/.m2/wrapper/dists/apache-maven-3.9.6"

if [ ! -d "$MAVEN_HOME" ]; then
    echo "Downloading Apache Maven 3.9.6..."
    mkdir -p "$HOME/.m2/wrapper/dists"
    TMPFILE=$(mktemp /tmp/maven-XXXXXX.zip)
    curl -fsSL "$DISTRIBUTION_URL" -o "$TMPFILE"
    unzip -q "$TMPFILE" -d "$HOME/.m2/wrapper/dists"
    mv "$HOME/.m2/wrapper/dists/apache-maven-3.9.6" "$MAVEN_HOME" 2>/dev/null || true
    rm -f "$TMPFILE"
    echo "Maven downloaded."
fi

MVN_CMD=$(find "$MAVEN_HOME" -name "mvn" -type f | head -1)
exec "$MVN_CMD" "$@"
