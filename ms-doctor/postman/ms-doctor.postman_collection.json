{
  "info": {
    "name": "ms-doctor - Ejemplos",
    "description": "Ejemplos Postman para rutas directas y via API Gateway de ms-doctor.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8082"
    },
    {
      "key": "gatewayUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Directo",
      "item": [
        {
          "name": "GET listar doctores",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/doctores"
          }
        },
        {
          "name": "GET doctor por ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/doctores/1"
          }
        },
        {
          "name": "GET doctor por RUT",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/doctores/rut/11222333-4"
          }
        },
        {
          "name": "GET doctores por especialidad",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/doctores/especialidad/1"
          }
        },
        {
          "name": "GET listar especialidades",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/especialidades"
          }
        },
        {
          "name": "POST crear doctor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rut\": \"12344321-9\",\n  \"nombre\": \"Valentina\",\n  \"apellido\": \"Fuentes\",\n  \"email\": \"valentina.fuentes@clinica.local\",\n  \"telefono\": \"+56944445555\",\n  \"numeroRegistro\": \"REG-MED-3001\",\n  \"especialidadId\": 1,\n  \"fechaContratacion\": \"2023-04-01\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/doctores"
          }
        },
        {
          "name": "PUT actualizar doctor",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rut\": \"12344321-9\",\n  \"nombre\": \"Valentina\",\n  \"apellido\": \"Fuentes Diaz\",\n  \"email\": \"valentina.fuentes@clinica.local\",\n  \"telefono\": \"+56944445555\",\n  \"numeroRegistro\": \"REG-MED-3001\",\n  \"especialidadId\": 1,\n  \"fechaContratacion\": \"2023-04-01\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/api/doctores/1"
          }
        },
        {
          "name": "PATCH desactivar doctor",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/doctores/1/desactivar"
          }
        },
        {
          "name": "DELETE doctor administrativo",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/doctores/1"
          }
        }
      ]
    },
